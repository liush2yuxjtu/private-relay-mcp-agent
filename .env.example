# Shared by Vercel agent and local MCP. Generate strong random values.
PRIVATE_MCP_TOKEN=
DEMO_ACCESS_KEY=

# Public HTTPS tunnel endpoint, ending in /mcp.
PRIVATE_MCP_URL=https://example.trycloudflare.com/mcp
# Preferred demo route: GLM Coding Plan (OpenAI-compatible).
GLM_CODING_PLAN_API_KEY=
GLM_MODEL=glm-4.7
# Fallback providers:
XFYUN_CODING_PLAN_API_KEY=
XFYUN_MODEL=astron-code-latest
KIMI_CODE_API_KEY=
KIMI_API_KEY=
AI_MODEL=glm-4.7

# Local-only settings.
LOCAL_DATA_ROOT=./local-data
MCP_PORT=8791
REMOTE_AGENT_URL=https://your-project.vercel.app/api/agent
WECOM_BOT_ID=
WECOM_BOT_SECRET=
